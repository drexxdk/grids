{
  "name": "grids-workspace",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "start": "npm run dev",
    "dev": "concurrently -k -n api,web \"npm run dev -w @grids/api\" \"npm run dev -w @grids/web\"",
    "dev:web": "npm run dev -w @grids/web --",
    "dev:api": "npm run dev -w @grids/api",
    "build": "npm run typecheck -w @grids/api && npm run build -w @grids/web --",
    "build:web": "npm run build -w @grids/web --",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "preview": "npm run preview -w @grids/web --",
    "check": "npm run build && npm run test:api",
    "pretest": "npm run build",
    "test": "npm exec -w @grids/web -- playwright test",
    "test:api": "npm test -w @grids/api",
    "test:database": "npm run test:database -w @grids/api",
    "db:up": "docker compose up -d --wait postgres",
    "db:stop": "docker compose stop postgres",
    "db:migrate": "npm run migrate -w @grids/database",
    "postinstall": "patch-package --error-on-fail"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "patch-package": "^8.0.1"
  }
}
