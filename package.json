{
  "name": "grids",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local image grid editor with PNG, JPEG, and WebP export",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "check": "npm run build",
    "pretest": "npm run build",
    "test": "playwright test",
    "postinstall": "patch-package --error-on-fail"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@use-gesture/react": "^10.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.7",
    "i18next": "^26.6.0",
    "i18next-icu": "^2.6.1",
    "lucide-react": "^0.468.0",
    "motion": "^14.9.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-easy-crop": "^6.2.4",
    "react-i18next": "^17.1.10",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "patch-package": "^8.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.2.0",
    "vite-plugin-pwa": "1.1.0"
  }
}
