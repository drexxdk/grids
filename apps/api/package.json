{
  "name": "@grids/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:database": "tsx --env-file-if-exists=../../.env --test tests/*.integration.ts"
  },
  "dependencies": {
    "@grids/contracts": "*",
    "@grids/database": "*",
    "cookie": "^1.0.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "tsx": "^4.20.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^22.19.0",
    "typescript": "^7.0.2"
  }
}
