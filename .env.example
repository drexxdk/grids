# Copy to the repository-root .env. Fill only the providers you intend to use.
# Never commit .env or share real credentials.
#
# Commons, The Met, SMK, iNaturalist, Openverse, Rijksmuseum and Wellcome need no credentials.
# Sign-in and database variables below are runtime configuration.
# Other image-provider credentials remain a future-integration checklist.
# Credentialed providers need reviewed terms and secure backend/gateway hosting.
# Never prefix secrets with VITE_: Vite exposes VITE_* values in browser builds.
# GitHub Pages cannot keep secrets or run the API.

# LOCAL DATABASE AND API
# Choose a password and use the same value (URL-encoded) in DATABASE_URL.
# Port 5433 avoids Chatter's default Postgres port 5432.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://grids:CHANGE_ME@localhost:5433/grids
PORT=5841
WEB_URL=http://localhost:5837/
PUBLIC_API_URL=http://localhost:5841
TRUST_PROXY_HOPS=0
NODE_ENV=development
# Production requires HTTPS and the same secret in the API and Pages proxy.
GRIDS_PROXY_SECRET=
# Keep this empty locally. See deploy/*.env.example for the production stack.
# Vite reads apps/web/.env, not this root file. If the API is not proxied at
# /api, set VITE_API_URL=https://api.example.com/api in apps/web/.env.
# This public URL is not a secret. Never put OAuth secrets in that file.

# KEYLESS IMAGE PROVIDERS (no keys to obtain)
# Implemented: Wikimedia Commons, The Met, SMK, iNaturalist, Openverse,
# Rijksmuseum and Wellcome Collection.
# Candidates: AniList public catalog queries, Jikan, Open Library,
# Scryfall, PokeAPI, The Met Collection, NASA Image and Video Library,
# MusicBrainz public metadata and Cover Art Archive.
# NASA's Image and Video Library does not require an api.nasa.gov API key.
# MusicBrainz still requires appropriate application identification/rate limits.

# PLANNED IMAGE PROVIDERS (server-side credentials, not browser variables)

# TMDB: register an application in account settings > API.
# https://www.themoviedb.org/settings/api
# The read access token is sufficient; do not enter your account password.
TMDB_READ_ACCESS_TOKEN=

# IGDB: register a Twitch developer application and enable account 2FA.
# https://dev.twitch.tv/console/apps
# https://api-docs.igdb.com/#account-creation
# These obtain a short-lived access token server-side; do not paste one here.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# RAWG: register for API access and review the applicable plan/usage terms.
# https://rawg.io/apidocs
RAWG_API_KEY=

# Unsplash: register an application and review the API production requirements.
# https://unsplash.com/developers
# Only the Access Key is needed for public image search/download tracking.
UNSPLASH_ACCESS_KEY=

# Pexels: request an API key from your account.
# https://www.pexels.com/api/
PEXELS_API_KEY=

# Pixabay: sign in to obtain the API key shown in the documentation.
# https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Europeana: register for an API key and review current access requirements.
# https://pro.europeana.eu/page/get-api
EUROPEANA_API_KEY=

# OPTIONAL PROVIDER-ONLY SIGN-IN (separate from image search)
# Configure both values to enable a provider. No password/local accounts.
# Register PUBLIC_API_URL/api/auth/PROVIDER/callback for each enabled provider,
# e.g. http://localhost:5841/api/auth/google/callback for Google locally.
# Do not register a GitHub Pages URL as a server-side OAuth callback.

# Google: create an OAuth web application client.
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord: create an application and use its OAuth2 credentials.
# https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Facebook: create an application with Facebook Login.
# https://developers.facebook.com/apps/
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=